# Server
PORT=4000
NODE_ENV=development

# CORS — frontend origin(s) allowed to call the API
# Local dev:    CORS_ORIGIN=http://localhost:5173
# Production:   CORS_ORIGIN=*  (or your exact Vercel URL for stricter control)
# Multiple:     CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Database — relative paths are resolved from the backend root
DATABASE_PATH=./data/fund_intelligence.db

# JWT — use long random strings in production. Different secrets for access and refresh
# tokens so a leaked access token cannot be used to mint refresh tokens, and vice versa.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-me-with-a-long-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed user credentials (mock auth — see README)
SEED_USER_EMAIL=demo@nordic.io
SEED_USER_PASSWORD=demo123
